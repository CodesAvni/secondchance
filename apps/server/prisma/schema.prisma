generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String        @id @default(uuid())
  name                     String
  email                    String        @unique
  role                     String
  bio                      String?
  location                 String?
  languages                String[]
  accessibilityPreferences String[]
  preferredLanguage        String?
  communicationPreference  String?
  workPreference           String?
  availability             String?
  screenReaderSupport      Boolean?      @default(false)
  captionRequirement       Boolean?      @default(false)
  createdAt                DateTime      @default(now())
  onboardingCompleted      Boolean       @default(false)
  password                 String
  applications             Application[]
  opportunities            Opportunity[]
  profile                  Profile?
  reviewsGiven             Review[]      @relation("Reviewer")
  reviewsReceived          Review[]      @relation("Target")
  userSkills               UserSkill[]
  
}

model Skill {
  id       String      @id @default(uuid())
  name     String
  category String
  users    UserSkill[]
}
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}
model UserSkill {
  userId          String
  skillId         String
  experienceLevel SkillLevel
  skill           Skill  @relation(fields: [skillId], references: [id])
  user            User   @relation(fields: [userId], references: [id])

  @@id([userId, skillId])
}

model Opportunity {
  id                   String        @id @default(uuid())
  title                String
  description          String
  remote               Boolean       @default(false)
  pay                  Int?
  location             String?
  accessibilitySupport String?
  employerId           String
  applications         Application[]
  employer             User          @relation(fields: [employerId], references: [id])
}
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
model Application {
  id            String      @id @default(uuid())
  applicantId   String
  opportunityId String
  audioIntroUrl String?
  status        ApplicationStatus      @default(PENDING)
  createdAt     DateTime    @default(now())
  applicant     User        @relation(fields: [applicantId], references: [id])
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
}

model Review {
  id           String  @id @default(uuid())
  reviewerId   String
  targetUserId String
  rating       Int
  comment      String?
  reviewer     User    @relation("Reviewer", fields: [reviewerId], references: [id])
  target       User    @relation("Target", fields: [targetUserId], references: [id])
}

model Profile {
  id                      String  @id @default(uuid())
  userId                  String  @unique
  preferredLanguage       String?
  accessibilityNeeds      String?
  communicationPreference String?
  workPreference          String?
  user                    User    @relation(fields: [userId], references: [id])
    resumeUrl String?
}
